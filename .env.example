# ==============================================================================
# EcoLogística - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# NOTA DE SEGURIDAD:
# Este archivo es solo una plantilla referencial.
# NUNCA ingresar claves de producción, contraseñas o API keys reales en este archivo.
# Copie este archivo a '.env' para su configuración local.
# ==============================================================================

# ------------------------------------------------------------------------------
# Configuración General del Servidor / Backend
# ------------------------------------------------------------------------------
PORT=8000
NODE_ENV=development
APP_NAME=EcoLogistica
API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Ámbito geográfico de pedidos (RF-02.2) - valores de aproximación a validar con el negocio
# ------------------------------------------------------------------------------
AMBITO_LAT_MIN=-12.20
AMBITO_LAT_MAX=-11.95
AMBITO_LON_MIN=-75.35
AMBITO_LON_MAX=-75.10
AMBITO_DISTRITOS=Huancayo,El Tambo,Chilca,Pilcomayo,San Agustín de Cajas

# ------------------------------------------------------------------------------
# Base de Datos (PostgreSQL / PostGIS)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecologistica_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/ecologistica_db

# ------------------------------------------------------------------------------
# Autenticación y Seguridad
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_change_in_local_env
JWT_EXPIRES_IN=1d

# ------------------------------------------------------------------------------
# Servicios de Mapas y Tráfico Geográfico (APIs Externas)
# ------------------------------------------------------------------------------
MAPS_API_KEY=your_maps_api_key_here
TRAFFIC_API_KEY=your_traffic_api_key_here
GEOCODING_API_URL=https://api.example.com/geocode

# ------------------------------------------------------------------------------
# Motor de Optimización Metaheurística (VRPTW & Green VRP)
# ------------------------------------------------------------------------------
OPTIMIZER_MAX_ITERATIONS=1000
OPTIMIZER_POPULATION_SIZE=100
OPTIMIZER_MUTATION_RATE=0.05
DEFAULT_CO2_EMISSION_FACTOR_KG_PER_KM=0.192

# ------------------------------------------------------------------------------
# Configuración Frontend (Cliente Web)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
VITE_MAP_TILE_PROVIDER=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAPS_PUBLIC_KEY=your_public_maps_key_here
