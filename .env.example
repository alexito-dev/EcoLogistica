# Variables que consume la aplicación ejecutable actual.
# Copiar a .env en la raíz del repositorio; no guardar secretos reales en Git.

# API FastAPI: origen permitido del frontend
CORS_ORIGIN=http://localhost:3000

# Ámbito de pedidos. Rectángulo provisional que debe validarse con el negocio.
AMBITO_LAT_MIN=-12.20
AMBITO_LAT_MAX=-11.95
AMBITO_LON_MIN=-75.35
AMBITO_LON_MAX=-75.10
AMBITO_DISTRITOS=Huancayo,El Tambo,Chilca,Pilcomayo,San Agustín de Cajas

# Autenticación. Dejar JWT_SECRET vacío genera una clave aleatoria al iniciar;
# las sesiones se invalidan al reiniciar si no se configura una clave persistente.
JWT_SECRET=
COOKIE_SECURE=false

# PostgreSQL/PostGIS local (docker compose usa estos valores)
POSTGRES_DB=ecologistica
POSTGRES_USER=eco_local
POSTGRES_PASSWORD=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://eco_local:REEMPLAZAR_POR_UN_SECRETO_ALEATORIO@127.0.0.1:5433/ecologistica

# Contraseña para las cuentas locales de demostración.
# Vacía: se genera una aleatoria y se muestra una sola vez en la consola del backend.
DEMO_CLAVE=
# true: al arrancar se cargan 6 pedidos y 3 vehículos de demostración (datos sintéticos de Huancayo)
DEMO_PEDIDOS=false

# Depósito desde donde salen las rutas (referencial)
DEPOSITO_NOMBRE=Centro de distribución Huancayo
DEPOSITO_LAT=-12.0651
DEPOSITO_LON=-75.2049

# URL de la API consumida por Vite
VITE_API_URL=http://localhost:8000/api/v1
